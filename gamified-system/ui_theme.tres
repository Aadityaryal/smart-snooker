[gd_resource type="Theme" load_steps=7 format=3]

; ─────────────────────────────────────────────────────────────────────────────
; Dark-modern UI theme (charcoal panels, green/cyan accents).
; Registered project-wide via project.godot [gui] theme/custom, so it styles the
; menu, settings, sandbox, challenge, drills and every code-built Control that
; doesn't override its own stylebox. In-game buttons that DO set their own
; add_theme_stylebox_override (control band, sandbox _mk_button) keep their look.
; ─────────────────────────────────────────────────────────────────────────────

